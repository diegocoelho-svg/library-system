{
  "name": "library-system",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de bibliotecas - monorepo",
  "author": "Diego Coelho",
  "license": "ISC",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @library-system/api",
    "dev:web": "npm run dev --workspace @library-system/web",
    "build:web": "npm run build --workspace @library-system/web",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "ultracite": "^5.3.7"
  }
}
